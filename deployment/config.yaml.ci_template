environment: "PROD"

server:
  port: 8080
  host: "0.0.0.0"
  base_url: "http://0.0.0.0:8080"

oidc:
  provider_url: "{{OIDC_PROVIDER_URL}}"
  client_id: "{{OIDC_CLIENT_ID}}"
  client_secret: "{{OIDC_CLIENT_SECRET}}"
  redirect_url: "{{OIDC_REDIRECT_URL}}"
  scopes:
    - "openid"
    - "profile"
    - "email"
  user_claim: "email"
  group_claim: "groups"
  allowed_groups: []
  denied_groups: []
  require_group_match: false
  group_match_strategy: "any"
  timeout: 30
  max_retries: 3
  retry_delay: 2

database:
  use_dbc: {{USE_DBC}}
  dbc_file: "{{DBC_FILE_PATH}}"
  apps_user: "SYSADMIN"
  username: "{{DB_USER}}"
  password: "{{DB_PASSWORD}}"
  connection_string: "{{DB_CONNECTION_STRING}}"
  pool_size: 10
  max_open_conns: 20
  max_idle_conns: 5

ebs:
  base_url: "{{EBS_URL}}"
  home_page: "/OA_HTML/AppsLogin"
  cookie_domain: "{{COOKIE_DOMAIN}}"
  cookie_secure: false
  trusted_node_name: "SSO_GATEWAY_NODE"
  trusted_node_secret: "{{TRUSTED_NODE_SECRET}}"
  enable_proxy: true
  enable_return_url: true
  max_upload_size: 104857600
  allowed_paths:
    - "/OA_HTML/*"
    - "/webadi/*"
    - "/servlets/*"
    - "/forms/*"
    - "/oa_servlets/*"
    - "/servlet/*"

logging:
  level: "info"
  format: "json"
  output: "stdout"

session:
  timeout_minutes: 480
  cookie_name: "EBS_SSO_SESSION"
  sync_with_ebs: true
  refresh_before_expiry: 5
  enable_auto_refresh: true
  enable_session_tracking: true
  cleanup_interval: 10
  max_concurrent_sessions: 0
  expiry_warning_minutes: 10
  grace_period_minutes: 5

resilience:
  enable_circuit_breaker: true
  failure_threshold: 5
  success_threshold: 2
  circuit_timeout: 60
  enable_retry: true
  max_retries: 3
  retry_delay: 2
  retry_backoff: true
  database_timeout: 10
  oidc_timeout: 30
  ebs_timeout: 30
  enable_health_check: true
  health_check_interval: 60

authorization:
  enable_authorization: false
  mode: "permissive"
  on_failure_action: "deny"
  enable_audit_log: true
  audit_log_path: "/var/log/ebssso/audit.log"
